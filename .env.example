# Public OpenAI-compatible API
API_KEY=change-me
HOST=0.0.0.0
PORT=10000

# OpenCode backend
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_DIRECTORY=/workspace
OPENCODE_REQUEST_TIMEOUT_MS=600000

# Optional Basic auth used by `opencode serve`
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=change-backend-password

# Remove the short-lived OpenCode session after every request.
CLEANUP_SESSIONS=true
